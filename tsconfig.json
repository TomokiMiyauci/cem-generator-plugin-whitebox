{
  "compilerOptions": {
    "types": ["node", "bun"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "moduleDetection": "force",
    "module": "esnext",
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true
  }
}
